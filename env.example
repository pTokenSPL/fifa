# api-football.com v3 — provides live fixtures, standings, and squad data
# Free tier available at https://www.api-football.com
FOOTBALL_API_KEY=your_key_here

# Optional: override the default in-memory cache TTL (seconds, default: 120)
CACHE_TTL_SECONDS=120
