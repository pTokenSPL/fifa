{
  "name": "wc2026-sdk",
  "version": "0.1.0",
  "description": "Free real-time TypeScript SDK for FIFA World Cup 2026 data — fixtures, standings, squads, bracket, match events, and derived intelligence signals.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fifa",
    "world-cup",
    "wc2026",
    "football",
    "soccer",
    "realtime",
    "sdk",
    "typescript",
    "free",
    "open"
  ],
  "author": "wc2026-sdk contributors",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0"
  }
}
